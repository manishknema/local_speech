# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local logs and runtime outputs
logs/

# Large binary model files — download via scripts/ensure_models_assets.py
assets/models/*.onnx
assets/models/*.bin
assets/models/*.pt

# Vendored Sherpa runtime DLLs — not tracked, copied during build
assets/runtime/

# Claude Code agent memory — local only
.claude/

# Local fixture artifacts generated by automation (keep configs/manifests tracked)
test_fixtures/raw/
test_fixtures/noisy_variants/
test_fixtures/paths.local.json

# Temporary script outputs
*.tmp
